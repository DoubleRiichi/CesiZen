# Stage 1: Builder
FROM rust:1.93-slim AS builder

# Dépendances système nécessaires à sqlx et bcrypt
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install sqlx-cli --no-default-features --features postgres

WORKDIR /app

# Copie des manifestes en premier pour profiter du cache Docker
COPY api/Cargo.toml api/Cargo.lock ./

# Astuce : pré-compiler les dépendances avec un main.rs vide
RUN mkdir -p src && echo "fn main() {}" > src/main.rs
RUN cargo build --release
RUN rm -rf src

# Copie du vrai code source
COPY api/src ./src

# Toucher main.rs pour forcer la recompilation
RUN touch src/main.rs
RUN cargo build --release

# Stage 2: Runtime
FROM rust:1.93-slim AS runtime

RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx

WORKDIR /app

COPY --from=builder /app/target/release/Cesizen ./api
COPY api/migrations ./migrations
COPY api/entrypoint.sh ./entrypoint.sh
RUN chmod +x entrypoint.sh

EXPOSE 8080

CMD ["./entrypoint.sh"]